# Environment Configuration Example
# Copy to .env.development (or .env.staging, .env.production) and fill in the values.

# Application Settings
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings (leave empty to run without tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Settings
OPENAI_API_KEY="your-llm-api-key" # e.g. OpenAI API key
# Optional: any OpenAI-compatible server (Azure OpenAI, vLLM, Ollama...). Default: https://api.openai.com/v1
# OPENAI_BASE_URL=http://localhost:11434/v1
DEFAULT_LLM_MODEL=gpt-5-mini
# Optional: models to fall back to, in order. Leave unset for the built-in OpenAI list.
# LLM_FALLBACK_MODELS=gpt-5,gpt-4o-mini
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=2000
MAX_CONTEXT_TOKENS=16000

# Long-term memory (mem0). The dimensions must match the embedding model.
LONG_TERM_MEMORY_MODEL=gpt-5-nano
LONG_TERM_MEMORY_EMBEDDER_MODEL=text-embedding-3-small
LONG_TERM_MEMORY_EMBEDDER_DIMS=1536
# mem0 sends usage telemetry to PostHog unless this is False
MEM0_TELEMETRY=False

# JWT Settings
# Required. Anyone who knows this value can sign in as any user, and the API refuses to start
# without a long random one. Generate it with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
# Threads for blocking work (database queries, mem0's model calls)
THREAD_POOL_SIZE=64

# Grafana (docker compose)
GRAFANA_ADMIN_PASSWORD=change-this-password

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console
